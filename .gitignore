**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables
.env
.env.local
.env.*.local

# APK releases (too large for git)
/build/apk_releases/*.apk
/build/app/outputs/flutter-apk/*.apk
/build/app/outputs/bundle/

# Debug symbols
/debug-info/

# Firebase configuration (contains sensitive data)
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
hiremebuddy-*.json
*-firebase-adminsdk-*.json

# Keystore and signing credentials (NEVER COMMIT)
*.keystore
*.jks
key.properties
/android/key.properties
/android/*.keystore
/android/*.jks

# Service account credentials (NEVER COMMIT)
*.serviceaccount*.json
.serviceaccount*.json
.sa_*.txt
.sa_*.json
test_jwt.js

# Development scripts with hardcoded credentials
.dev_supabase_serve.ps1
*_local.ps1

# IDE specific
.vscode/settings.json
*.code-workspace

# macOS
.DS_Store

